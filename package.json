{
  "name": "battered-batteries",
  "version": "0.1.0",
  "private": true,
  "main": "dist/functions/*.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prestart": "npm run build",
    "start": "func start",
    "storage": "azurite --silent --location .azurite",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@azure/functions": "^4.0.0",
    "axios": "^1.0.0",
    "axios-retry": "^4.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "azure-functions-core-tools": "^4.0.0",
    "azurite": "^3.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.0"
  }
}
